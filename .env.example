# to see if your .env file is working correctly by running `docker-compose config`

# the site name
NEXT_PUBLIC_APP_NAME=Web-SyncPlay

# modify if you pass your own running valkey instance
VALKEY_URL=redis://localhost:6379
NODE_ENV=development

# the binary path for yt-dlp
YTDLP_BIN=yt-dlp

# optional: cap concurrent yt-dlp processes (default 2)
# YTDLP_MAX_CONCURRENT=2

# optional: kill yt-dlp after this many ms (default 30000)
# YTDLP_TIMEOUT_MS=30000

# fallback media URL used when daily defaults cache is empty
FALLBACK_DEFAULT_MEDIA_URL=https://youtu.be/uD4izuDMUQA

# operator secret for /api/rooms/cleanup and /api/playlist/defaults/refresh
# required in production; optional in development
# OPS_SECRET=change-me-to-a-long-random-string

# allow proxying private/LAN URLs (dev only; default false)
# PROXY_ALLOW_PRIVATE_URLS=false

# control embed token lifetime in seconds (default 12h)
# CONTROL_TOKEN_TTL_SECONDS=43200

# local media relay: max bytes per provider WebSocket chunk (default 256KiB)
# LOCAL_MEDIA_RELAY_CHUNK_BYTES=262144
# local media relay: provider response timeout (default 15s)
# LOCAL_MEDIA_RELAY_TIMEOUT_MS=15000
# process-local block cache so N viewers share one provider upload (default 120s / 64MiB)
# LOCAL_MEDIA_BLOCK_CACHE_TTL_MS=120000
# LOCAL_MEDIA_BLOCK_CACHE_MAX_BYTES=67108864

# optional room limits
# ROOM_PARTICIPANTS_LIMIT=100
# ROOM_HISTORY_LIMIT=100
# ROOM_ACTION_LOG_LIMIT=500
# ROOM_PLAYLIST_LIMIT=50

# realtime coalesce / media cache (optional)
# PRESENCE_BATCH_INTERVAL_MS=250
# SNAPSHOT_COALESCE_MS=100
# ACTION_LOG_SNAPSHOT_MAX_MS=2000
# YTDLP_CACHE_TTL_SECONDS=1800
# HLS_REWRITE_CACHE_TTL_MS=15000
