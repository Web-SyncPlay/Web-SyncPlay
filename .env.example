# Web-SyncPlay environment
#
# Local Bun:  cp .env.example .env && bun install && bun run dev
# Docker:     cp .env.example .env && docker compose up -d --build
#
# Compose loads `.env` when present, then forces:
#   VALKEY_URL=redis://valkey:6379
#   NODE_ENV=production
# Schema/defaults: src/env.ts / Dockerfile.

# --- required for local Bun ---
VALKEY_URL=redis://localhost:6379
NODE_ENV=development

# Next.js telemetry (1 = disabled; also defaulted in next.config / Compose / image)
NEXT_TELEMETRY_DISABLED=1

# --- optional ---
# YTDLP_BIN=yt-dlp
# YTDLP_MAX_CONCURRENT=2
# YTDLP_TIMEOUT_MS=30000
# Retention input for Valkey extract cache (0–86400). Success TTL is capped by
# stream-URL max age; failures expire quickly (~60s).
# YTDLP_CACHE_TTL_SECONDS=1800

# FALLBACK_DEFAULT_MEDIA_URL=https://youtu.be/uD4izuDMUQA

# Dev/test only; always false in production
# PROXY_ALLOW_PRIVATE_URLS=false

# CONTROL_TOKEN_TTL_SECONDS=43200
# WS_HEARTBEAT_INTERVAL_MS=5000  # timeout is always 3× this

# ROOM_PARTICIPANTS_LIMIT=100
# ROOM_ACTION_LOG_LIMIT=500
# ROOM_PLAYLIST_LIMIT=50

# --- multi-replica local-media HTTP (set both or neither) ---
# Per-replica URL (pod DNS / hostname), NOT shared service DNS like http://web:3000.
# Keep /api/media/local/internal/* off public ingress.
# SFU stays process-local — see README.md#multi-replica-operations-sfu
# INTERNAL_NODE_BASE_URL=http://web-1:3000
# LOCAL_MEDIA_INTERNAL_SECRET=change-me-to-at-least-16-chars

# --- public site identity (ICE + CORS + CSP) ---
# PUBLIC_DOMAIN=web-syncplay.de
# mediasoup SFU listens on UDP 40000 (hardcoded).

# --- third-party iframe embeds (off by default) ---
# Space-separated absolute origins, or a single *.
# EMBED_FRAME_ANCESTORS=https://ani.example https://watch.example
