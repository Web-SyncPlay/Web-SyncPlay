# to see if your .env file is working correctly by running `docker-compose config`

# required
VALKEY_URL=redis://localhost:6379
NODE_ENV=development

# opt out of Next.js telemetry (https://nextjs.org/telemetry)
NEXT_TELEMETRY_DISABLED=1

# optional: display name (defaults to "Web-SyncPlay")
# NEXT_PUBLIC_APP_NAME=Web-SyncPlay

# optional: yt-dlp
# YTDLP_BIN=yt-dlp
# YTDLP_MAX_CONCURRENT=2
# YTDLP_TIMEOUT_MS=30000
# YTDLP_CACHE_TTL_SECONDS=1800

# optional: fallback media when daily defaults cache is empty
# FALLBACK_DEFAULT_MEDIA_URL=https://youtu.be/uD4izuDMUQA

# optional: operator secret for /api/rooms/cleanup and /api/playlist/defaults/refresh
# required in production; optional in development
# OPS_SECRET=change-me-to-a-long-random-string

# optional: allow proxying private/LAN URLs (dev/test only; forced false in production)
# PROXY_ALLOW_PRIVATE_URLS=false

# optional: control embed token lifetime in seconds (default 12h)
# CONTROL_TOKEN_TTL_SECONDS=43200

# optional: WebSocket heartbeat ping interval (default 5000).
# Timeout is always 3× this interval (not configurable).
# WS_HEARTBEAT_INTERVAL_MS=5000

# optional: room limits
# ROOM_PARTICIPANTS_LIMIT=100
# ROOM_HISTORY_LIMIT=100
# ROOM_ACTION_LOG_LIMIT=500
# ROOM_PLAYLIST_LIMIT=50

# Fixed in code (not env): presence/snapshot coalesce intervals, local-media
# relay chunk/timeout, local-media block cache TTL/size, HLS rewrite cache TTL,
# room TTL (1h), proxy token TTL (7d), yt-dlp lock/lease timings from YTDLP_*.
