# Web-SyncPlay environment
#
# Local Bun:  cp .env.example .env && bun install && bun run dev
# Docker:     cp .env.example .env, then:
#               docker compose up -d --build
# Validate:   docker compose config
#
# Compose loads this file as `.env` when present, then forces:
#   VALKEY_URL=redis://valkey:6379
#   NODE_ENV=production
# Other keys below are passed through to the web container.
# Image/schema defaults apply for any unset optional vars (see Dockerfile / src/env.ts).

# --- required for local Bun ---
# Use localhost when Valkey runs on the host or via compose port publish.
# Docker Compose overrides this to redis://valkey:6379 automatically.
VALKEY_URL=redis://localhost:6379
NODE_ENV=development

# Next.js telemetry (defaults to 1 / disabled in next.config, Compose, and the image)
NEXT_TELEMETRY_DISABLED=1

# --- optional ---
# yt-dlp (defaults shown; binary is installed in the Docker image)
# YTDLP_BIN=yt-dlp
# YTDLP_MAX_CONCURRENT=2
# YTDLP_TIMEOUT_MS=30000
# YTDLP_CACHE_TTL_SECONDS=1800

# Fallback media when daily defaults cache is empty
# FALLBACK_DEFAULT_MEDIA_URL=https://youtu.be/uD4izuDMUQA

# Allow proxying private/LAN URLs (dev/test only; always false in production)
# PROXY_ALLOW_PRIVATE_URLS=false

# Control embed token lifetime in seconds (default 12h)
# CONTROL_TOKEN_TTL_SECONDS=43200

# WebSocket heartbeat ping interval in ms (default 5000).
# Timeout is always 3× this interval (not configurable).
# WS_HEARTBEAT_INTERVAL_MS=5000

# Room limits
# ROOM_PARTICIPANTS_LIMIT=100
# ROOM_ACTION_LOG_LIMIT=500
# ROOM_PLAYLIST_LIMIT=50

# --- multi-replica local-media HTTP (optional) ---
# When both are set, cache-miss range fetches prefer the node holding the
# provider WebSocket via internal HTTP before Redis pub/sub flood.
# Keep /api/media/local/internal/* off public ingress.
# SFU is still process-local: provider WS + SFU viewers must share one replica
# (see README.md#multi-replica-operations-sfu).
# INTERNAL_NODE_BASE_URL=http://web:3000
# LOCAL_MEDIA_INTERNAL_SECRET=change-me-to-at-least-16-chars

# --- public site identity (ICE + CORS + CSP) ---
# Hostname or origin browsers use to reach this deployment.
# Examples: web-syncplay.de
# PUBLIC_DOMAIN=web-syncplay.de
# mediasoup SFU always listens on UDP 40000 (hardcoded; firewall/forward that port).

# --- third-party iframe embeds (off by default) ---
# Space-separated absolute origins allowed in CSP frame-ancestors, or a single *.
# Unset/empty = only same-origin (and PUBLIC_DOMAIN) may iframe this app.
# Examples:
#   EMBED_FRAME_ANCESTORS=https://ani.example https://watch.example
#   EMBED_FRAME_ANCESTORS=*
# EMBED_FRAME_ANCESTORS=
