{
  "name": "web-syncplay",
  "version": "3.0.3",
  "private": true,
  "packageManager": "bun@1.4.4-canary.20261028.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "postinstall": "bun scripts/prepare-static-assets.ts",
    "prepare:assets": "bun scripts/prepare-static-assets.ts",
    "check:local-media-sw": "bun scripts/build-local-media-sw.ts --verify",
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --webpack",
    "prebuild": "bun scripts/prepare-static-assets.ts",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "start": "bun scripts/start-standalone.ts",
    "check": "bun check",
    "format": "bun fmt --check",
    "format:write": "bun fmt",
    "test": "bun test",
    "test:unit": "bun test src/server src/contracts src/shared src/client src/components src/hooks src/env.test.ts --path-ignore-patterns='**/*.integration.test.ts'",
    "test:integration": "bun test src/server/redis/state-store.presence.integration.test.ts",
    "test:fuzz": "bun scripts/run-property-fuzz.ts",
    "test:e2e": "bun scripts/e2e-concurrent.ts",
    "test:e2e:ws": "bun scripts/e2e-ws-concurrent.ts",
    "test:e2e:password": "bun scripts/e2e-password-join.ts",
    "test:e2e:local-media": "bun scripts/e2e-local-media-relay.ts",
    "test:e2e:ui": "bun scripts/e2e-ui.ts",
    "test:e2e:action-log": "bun scripts/e2e-action-log.ts",
    "test:a11y": "bun scripts/a11y-wcag.ts",
    "test:e2e:all": "bun run test:a11y && bun run test:e2e && bun run test:e2e:ws && bun run test:e2e:password && bun run test:e2e:local-media && bun run test:e2e:ui",
    "test:full": "bun run test:unit && bun run test:integration && bun run test:e2e:all"
  },
  "allowScripts": {
    "mediasoup@3.30.1": true
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@dnd-kit/react": "^0.5.1",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@number-flow/react": "^0.6.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vidstack/react": "1.15.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dashjs": "4.7.4",
    "hls.js": "1.7.3",
    "lucide-react": "^1.61.0",
    "mediasoup": "^3.30.1",
    "mediasoup-client": "^3.25.3",
    "next": "^16.4.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "redis": "^6.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "unique-names-generator": "^4.7.1",
    "ws": "^8.22.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@ffmpeg/core": "^0.12.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "fast-check": "^4.10.2",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2"
  }
}
