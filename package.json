{
  "name": "web-syncplay",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "postinstall": "bun scripts/prepare-static-assets.ts",
    "prepare:assets": "bun scripts/prepare-static-assets.ts",
    "check:local-media-sw": "bun scripts/build-local-media-sw.ts --verify",
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "prebuild": "bun scripts/prepare-static-assets.ts",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "lint": "eslint",
    "typecheck": "bunx --package @typescript/native tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "test:unit": "bun test src/server src/contracts src/shared src/client src/components src/hooks src/env.test.ts --path-ignore-patterns='**/*.integration.test.ts'",
    "test:integration": "bun test src/server/redis/state-store.presence.integration.test.ts",
    "test:fuzz": "bun scripts/run-property-fuzz.ts",
    "test:e2e": "bun scripts/e2e-concurrent.ts",
    "test:e2e:ws": "bun scripts/e2e-ws-concurrent.ts",
    "test:a11y": "bun scripts/a11y-wcag.ts",
    "format": "prettier --write ."
  },
  "allowScripts": {
    "mediasoup@3.28.0": true
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@dnd-kit/react": "^0.5.0",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vidstack/react": "1.15.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dashjs": "4.7.4",
    "hls.js": "1.5.18",
    "lucide-react": "^1.52.0",
    "mediasoup": "^3.28.0",
    "mediasoup-client": "^3.24.4",
    "next": "^16.3.8",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "redis": "^6.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "unique-names-generator": "^4.7.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@ffmpeg/core": "^0.12.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "playwright": "^1.63.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
